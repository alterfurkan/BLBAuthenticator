# Frontend ortam değişkenleri
# Geliştirmede Vite proxy kullanılır; production build'de tam API URL gerekir

# Production API base URL (CapRover deploy sonrası)
# Örnek: https://blb-auth-api.yourdomain.com
VITE_API_URL=

# Geliştirme proxy hedefi (vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:3000
