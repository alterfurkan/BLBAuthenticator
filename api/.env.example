# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT — production'da güçlü rastgele bir değer kullanın (min 32 karakter)
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# TOTP secret şifreleme anahtarı (32 byte hex = 64 karakter)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=blb_auth
DB_PASSWORD=blb_auth_secret
DB_NAME=blb_authenticator

# CORS — frontend origin (virgülle ayırarak birden fazla eklenebilir)
CORS_ORIGIN=http://localhost:5173

# Uygulama adı (TOTP QR kodunda görünür)
APP_NAME=BLB Authenticator
